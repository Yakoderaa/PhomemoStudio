<Window x:Class="PhomemoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Phomemo Studio D30"
        Width="1420" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B1020"
        SnapsToDevicePixels="True"
        Icon="Assets/sr-gato.png">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="7"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="WindowControlButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E6ECF7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26324A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#34435F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseWindowControlButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#A52215" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#0B1020" BorderBrush="#27334B" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#101728">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="TitleBarDragZone"
                Grid.Column="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid Margin="10,0,14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="32" Height="32"
                   Margin="0,0,9,0"
                   Stretch="Uniform"
                   Source="Assets/sr-gato.png" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold" Text="Phomemo Studio" />
              <TextBlock x:Name="VersionText" Margin="0,1,0,0" Foreground="#8292AD" FontSize="10" Text="D30 Desktop" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Ellipse Width="7" Height="7" Fill="#52D68A" Margin="0,0,7,0" />
              <TextBlock x:Name="UpdateStatusText"
                         Foreground="#B9C5D9"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Text="Actualizaciones automáticas activas" />
            </StackPanel>
          </Grid>
        </Border>

        <Button x:Name="SearchUpdateButton"
                Grid.Column="1"
                Margin="0,7,8,7"
                Padding="13,0"
                MinWidth="158"
                Background="#6C4DFF"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                FontSize="11"
                Cursor="Hand"
                Click="SearchUpdates_Click">
          Buscar actualizaciones
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource WindowControlButton}"
                  ToolTip="Minimizar"
                  Content="—"
                  Click="MinimizeWindow_Click" />
          <Button x:Name="MaximizeRestoreButton"
                  Style="{StaticResource WindowControlButton}"
                  ToolTip="Maximizar"
                  Content="□"
                  Click="MaximizeRestoreWindow_Click" />
          <Button Style="{StaticResource CloseWindowControlButton}"
                  ToolTip="Cerrar"
                  Content="×"
                  FontSize="20"
                  Click="CloseWindow_Click" />
        </StackPanel>
      </Grid>

      <Border x:Name="UpdateBanner"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#17233A"
              BorderBrush="#334A70"
              BorderThickness="0,1,0,1"
              Padding="14,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="UpdateTitle"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Text="Actualización" />
            <TextBlock x:Name="UpdateText"
                       Margin="0,2,12,0"
                       Foreground="#C9D4E8"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Preparando actualización…" />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ProgressBar x:Name="UpdateProgressBar"
                         Height="7"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Visibility="Collapsed" />
            <TextBlock x:Name="UpdateProgressText"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Right"
                       Foreground="#9FB0CB"
                       FontSize="10"
                       Visibility="Collapsed"
                       Text="0%" />
          </StackPanel>
        </Grid>
      </Border>

      <wv2:WebView2 x:Name="Web"
                    Grid.Row="2"
                    DefaultBackgroundColor="#0B1020" />
    </Grid>
  </Border>
</Window>
