<Window x:Class="PhomemoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Phomemo Studio"
        Width="1420" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#EEF1F6"
        SnapsToDevicePixels="True"
        Icon="Assets/sr-gato.ico">

  <Grid Background="#EEF1F6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Esta franja solo aparece mientras hay actividad del actualizador.
         La barra negra personalizada fue eliminada: mover/minimizar/maximizar/cerrar
         vuelven a quedar a cargo de Windows. -->
    <Border x:Name="UpdateBanner"
            Grid.Row="0"
            Visibility="Collapsed"
            Background="#F7F5FF"
            BorderBrush="#D9D2FF"
            BorderThickness="0,0,0,1"
            Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="UpdateTitle"
                     Foreground="#2B2348"
                     FontWeight="SemiBold"
                     FontSize="12"
                     Text="Actualización" />
          <TextBlock x:Name="UpdateText"
                     Margin="0,2,12,0"
                     Foreground="#625A78"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="Preparando actualización…" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <ProgressBar x:Name="UpdateProgressBar"
                       Height="7"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       Visibility="Collapsed" />
          <TextBlock x:Name="UpdateProgressText"
                     Margin="0,4,0,0"
                     HorizontalAlignment="Right"
                     Foreground="#726A87"
                     FontSize="10"
                     Visibility="Collapsed"
                     Text="0%" />
        </StackPanel>
      </Grid>
    </Border>

    <wv2:WebView2 x:Name="Web"
                  Grid.Row="1"
                  DefaultBackgroundColor="#EEF1F6" />

    <!-- Controles auxiliares invisibles. Mantienen el estado interno del updater
         sin volver a ocupar espacio en la interfaz. El botón visible para el usuario
         está dentro de la interfaz principal. -->
    <Grid Visibility="Collapsed" IsHitTestVisible="False">
      <Button x:Name="SearchUpdateButton" Click="SearchUpdates_Click">Buscar actualizaciones</Button>
      <TextBlock x:Name="UpdateStatusText" />
      <TextBlock x:Name="VersionText" />
      <Button x:Name="MaximizeRestoreButton" Click="MaximizeRestoreWindow_Click" />
    </Grid>
  </Grid>
</Window>
